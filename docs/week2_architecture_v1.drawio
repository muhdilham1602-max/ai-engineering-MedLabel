        </mxCell>
        <mxCell id="4" value="&lt;b&gt;Multi-Image Ingestion UI&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #475569;&quot;&gt;• Drag &amp; drop prescription slips&lt;br/&gt;• PNG, JPG, JPEG validation&lt;br/&gt;• Multi-image gallery preview&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="3">
          <mxGeometry x="30" y="45" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;Synchronized Crop Inspector&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #475569;&quot;&gt;• Interactive bounding box overlay&lt;br/&gt;• Split-screen original crop view&lt;br/&gt;• Traceability coordinates audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="3">
          <mxGeometry x="420" y="45" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;Interactive HITL Review Table&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #475569;&quot;&gt;• st.data_editor interactive grid&lt;br/&gt;• Real-time manual slot override&lt;br/&gt;• Accept / Modify / Delete rows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="3">
          <mxGeometry x="810" y="45" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Consolidated Timetable View&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #475569;&quot;&gt;• Chronological regimen schedule&lt;br/&gt;• Meal condition flags (AC / PC / ON)&lt;br/&gt;• JSON &amp; printable summary export&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="3">
          <mxGeometry x="1200" y="45" width="350" height="105" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;LAYER 2: APPLICATION CONTROLLER &amp; HUMAN-IN-THE-LOOP (HITL) GATE&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=2;fontColor=#14532D;fontSize=14;startSize=30;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="1580" height="130" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;Session State Manager&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;• In-memory session state store&lt;br/&gt;• Ephemeral image tensor cache&lt;br/&gt;• Audit trail event logger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="8">
          <mxGeometry x="30" y="45" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;Pipeline Coordinator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;• Asynchronous workflow orchestration&lt;br/&gt;• Error recovery &amp; quality check fallback&lt;br/&gt;• Decoupled pipeline controller&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="8">
          <mxGeometry x="520" y="45" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;MANDATORY HITL VERIFICATION GATE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;&lt;b&gt;SAFETY BARRIER&lt;/b&gt;: Completely blocks timetable generation until user inspects crops &amp; verifies data.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="8">
          <mxGeometry x="1030" y="45" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;LAYER 3: CORE INTELLIGENCE &amp; PROCESSING PIPELINE (src/ Modules)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#D8B4FE;strokeWidth=2;fontColor=#581C87;fontSize=14;startSize=30;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="450" width="1580" height="270" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;1. Preprocessing &amp; OCR&lt;br/&gt;(src/ocr.py)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;• Grayscale &amp; CLAHE contrast&lt;br/&gt;• Adaptive binarization &amp; deskew&lt;br/&gt;• Spatial bounding box coordinates&lt;br/&gt;• Token confidence scoring (τ)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="12">
          <mxGeometry x="30" y="45" width="280" height="205" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;2. Entity Extraction&lt;br/&gt;(src/extraction.py)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;• Regex &amp; clinical lexicon parser&lt;br/&gt;• Slot filling:&lt;br/&gt;  - Drug Name &amp; Strength&lt;br/&gt;  - Dose &amp; Frequency (OD/BD/TDS)&lt;br/&gt;  - Route &amp; Duration&lt;br/&gt;• Bilingual support (EN &amp; BM)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="12">
          <mxGeometry x="340" y="45" width="280" height="205" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;3. Reference Grounding&lt;br/&gt;(MOH Catalog Matcher)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;• Fuzzy matching (RapidFuzz)&lt;br/&gt;• Phonetic Double Metaphone&lt;br/&gt;• Brand -&gt; Generic normalization&lt;br/&gt;• Strength plausibility validation&lt;br/&gt;• Top-1 / Top-3 candidate ranking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="12">
          <mxGeometry x="650" y="45" width="280" height="205" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;4. Uncertainty &amp; Conflict&lt;br/&gt;(src/validation.py)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;• Low-confidence token flagging&lt;br/&gt;• Omitted critical field detection&lt;br/&gt;• Duplicate active ingredient alerts&lt;br/&gt;• Cumulative dosing safety checks&lt;br/&gt;• Actionable review badges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="12">
          <mxGeometry x="960" y="45" width="280" height="205" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;5. Timetable Scheduler&lt;br/&gt;(src/timetable.py)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #334155;&quot;&gt;• Frequency-to-slot mapping&lt;br/&gt;  (Morning, Afternoon, Evening, Night)&lt;br/&gt;• Meal constraint alignment (AC/PC)&lt;br/&gt;• Chronological conflict synthesis&lt;br/&gt;• Consolidated regimen output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="12">
          <mxGeometry x="1270" y="45" width="280" height="205" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;b&gt;LAYER 4: EXTERNAL KNOWLEDGE BASE &amp; EPHEMERAL DATA LAYER&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=2;fontColor=#78350F;fontSize=14;startSize=30;rounded=1;arcSize=4;" vertex="1" parent="1">
