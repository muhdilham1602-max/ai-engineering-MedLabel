      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;MedLabel — V1 System Architecture Diagram&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; font-weight: normal; color: #94A3B8;&quot;&gt;Multi-Prescription Image OCR, MOH Reference Grounding, HITL Verification &amp; Schedule Generation&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=none;fontColor=#FFFFFF;fontSize=18;align=left;spacingLeft=30;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;LAYER 1: USER INTERACTION &amp; PRESENTATION LAYER (Streamlit Frontend - app.py)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;startSize=30;rounded=1;arcSize=4;" vertex="1" parent="1">
