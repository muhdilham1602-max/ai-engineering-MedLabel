  <diagram id="medlabel_sys_arch" name="MedLabel System Architecture">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" background="#0B0F17" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;font style=&quot;font-size: 24px; font-weight: bold; color: #93C5FD;&quot;&gt;MedLabel — System Architecture&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 13px; color: #94A3B8;&quot;&gt;AI-assisted prescription recognition with mandatory human verification&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;User / Caregiver&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #E2E8F0;&quot;&gt;Uploads multiple prescription images&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13213C;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="170" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;Web Interface&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #CBD5E1;&quot;&gt;Streamlit upload &amp;amp; preview&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13213C;strokeColor=#475569;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="265" y="170" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;Image Quality Check&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #CBD5E1;&quot;&gt;Orientation, blur, contrast&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#182030;strokeColor=#64748B;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="170" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;OCR Engine&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #E9D5FF;&quot;&gt;Recognize printed text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#231733;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="735" y="170" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;Information Extraction&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #E9D5FF;&quot;&gt;Medicine, strength, dose, frequency and timing when explicitly stated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#231733;strokeColor=#A855F7;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="970" y="160" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;Medicine Reference Lookup&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #BBF7D0;&quot;&gt;Compare names with Malaysian pharmaceutical product metadata&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2A1D;strokeColor=#22C55E;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="970" y="350" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;Validation &amp;amp; Uncertainty Checks&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #FDE68A;&quot;&gt;Missing fields • low confidence&lt;br/&gt;potentially conflicting instructions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C1F0A;strokeColor=#EAB308;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="350" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;Human Review Screen&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #FDE68A;&quot;&gt;Show source image + extracted fields&lt;br/&gt;User corrects and confirms details&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C1F0A;strokeColor=#EAB308;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="350" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;font style=&quot;font-size: 11px; font-weight: bold; color: #FFFFFF;&quot;&gt;All required instructions verified and no unresolved conflict?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#2C1217;strokeColor=#F43F5E;strokeWidth=1.5;fontColor=#FFFFFF;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="520" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;Stop timetable generation&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #FECDD3;&quot;&gt;Flag issue for pharmacist / prescriber&lt;br/&gt;Do not guess or resolve conflict&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#38161A;strokeColor=#EF4444;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="535" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;Timetable Generator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #BBF7D0;&quot;&gt;Uses verified instructions only&lt;br/&gt;No inferred or recommended doses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F2A1D;strokeColor=#22C55E;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="535" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;Timetable Review &amp;amp; Reminder Plan&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 11px; color: #BAE6FD;&quot;&gt;User reviews before use&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#13213C;strokeColor=#38BDF8;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="970" y="535" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;Cross-cutting safeguards: consent • data minimization • secure storage • de-identification for research • audit trail&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#475569;strokeWidth=1;fontColor=#CBD5E1;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="720" width="960" height="60" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;font style=&quot;font-size: 11px; font-style: italic; color: #F87171;&quot;&gt;Safety boundary: MedLabel organizes user-verified prescription information; it does not diagnose, recommend doses, or replace a healthcare professional.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="200" y="790" width="900" height="30" as="geometry" />
